# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=erp_saas

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Application
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Fiscal Secret Management
SECRET_ENCRYPTION_KEY=change-this-key-with-at-least-32-characters
SECURE_FILES_ROOT=/var/lib/stock-control/private-files

# Fiscal transmission mode: SEFAZ (real SOAP) or MOCK (local mocked authorization)
FISCAL_TRANSMISSION_MODE=SEFAZ
